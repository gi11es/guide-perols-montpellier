---
import type { CollectionEntry } from 'astro:content';
interface Category { slug: string; label: string; color: string; }
interface Props {
  places: CollectionEntry<'places'>[];
  categories: Category[];
}
const { places, categories } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const detail = places.map((p) => ({
  slug: p.data.slug,
  name: p.data.name,
  category: p.data.category,
  address: p.data.address ?? '',
  hero: p.data.hero ?? '',
  links: p.data.links ?? {},
  lat: p.data.lat,
  lon: p.data.lon,
  description: p.data.description ?? '',
}));
const catBySlug = Object.fromEntries(categories.map((c) => [c.slug, c]));
---
<div id="sheet" class="sheet" aria-hidden="true">
  <button class="sheet-handle" aria-label="Fermer"></button>
  <button class="sheet-close" aria-label="Fermer">×</button>
  <div class="sheet-body"></div>
</div>

<script is:inline define:vars={{ detail, catBySlug, baseUrl }}>
  window.__GUIDE_SHEET__ = { detail, catBySlug, baseUrl };
</script>

<script>
  const sheet = document.getElementById('sheet')!;
  const body = sheet.querySelector('.sheet-body') as HTMLElement;
  const handle = sheet.querySelector('.sheet-handle') as HTMLElement;
  const closeBtn = sheet.querySelector('.sheet-close') as HTMLElement;
  const { detail, catBySlug, baseUrl } = (window as any).__GUIDE_SHEET__;
  const byslug = Object.fromEntries(detail.map((d: any) => [d.slug, d]));

  function getBookmarks(): string[] {
    try { return JSON.parse(localStorage.getItem('guide:bookmarks') ?? '[]'); } catch { return []; }
  }

  function render(slug: string) {
    const p = byslug[slug];
    if (!p) return;
    const cat = catBySlug[p.category];
    const insta = p.links.instagram
      ? `https://instagram.com/${p.links.instagram.replace(/^@/, '')}`
      : '';
    const mapsUrl = p.links.google_maps
      || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.name)}+${p.lat},${p.lon}`;
    const secondaryLinks = [
      p.links.website ? `<li><a href="${p.links.website}" target="_blank" rel="noopener">Site</a></li>` : '',
      insta ? `<li><a href="${insta}" target="_blank" rel="noopener">Instagram</a></li>` : '',
    ].filter(Boolean).join('');
    const bookmarked = getBookmarks().includes(slug);
    body.innerHTML = `
      ${p.hero ? `<img src="${baseUrl}${p.hero.replace(/^\//, '')}" alt="${p.name}" class="sheet-hero" />` : ''}
      <div class="sheet-text">
        <p class="eyebrow" style="color:${cat?.color ?? 'inherit'}">${cat?.label ?? p.category}</p>
        <div class="sheet-title-row">
          <h2>${p.name}</h2>
          <button class="sheet-star${bookmarked ? ' active' : ''}" data-slug="${slug}" aria-label="Favori">${bookmarked ? '★' : '☆'}</button>
        </div>
        ${p.description ? `<p class="place-description">${p.description}</p>` : ''}
        <a href="${mapsUrl}" target="_blank" rel="noopener" class="maps-cta">Ouvrir dans Google Maps</a>
        ${secondaryLinks ? `<ul class="links">${secondaryLinks}</ul>` : ''}
      </div>
    `;
    body.scrollTop = 0;
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
  }

  function close() {
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
    window.dispatchEvent(new CustomEvent('place:deselect'));
  }

  handle.addEventListener('click', close);
  closeBtn.addEventListener('click', close);

  // Swipe-down-to-close on mobile when the body is already scrolled to top.
  // Touch starts at the top of the sheet; if user pulls down past 80px, close.
  let touchStartY: number | null = null;
  let touchDeltaY = 0;
  let dragging = false;
  sheet.addEventListener('touchstart', (e) => {
    if (window.innerWidth >= 720) return; // desktop side-drawer, skip
    if (body.scrollTop > 0) return; // user is scrolling inside body
    touchStartY = e.touches[0].clientY;
    touchDeltaY = 0;
    dragging = false;
  }, { passive: true });
  sheet.addEventListener('touchmove', (e) => {
    if (touchStartY === null) return;
    touchDeltaY = e.touches[0].clientY - touchStartY;
    if (touchDeltaY > 8) {
      dragging = true;
      // Pull the sheet down with the finger
      sheet.style.transform = `translateY(${touchDeltaY}px)`;
      sheet.style.transition = 'none';
    }
  }, { passive: true });
  sheet.addEventListener('touchend', () => {
    if (!dragging) { touchStartY = null; return; }
    sheet.style.transition = '';
    sheet.style.transform = '';
    if (touchDeltaY > 80) close();
    touchStartY = null;
    touchDeltaY = 0;
    dragging = false;
  });

  window.addEventListener('sheet:close', () => {
    if (sheet.classList.contains('open')) close();
  });

  window.addEventListener('place:select', (e: any) => {
    render(e.detail.slug);
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  // Star button inside sheet
  body.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.sheet-star');
    if (!btn) return;
    const slug = btn.dataset.slug!;
    // Toggle
    const bookmarks: string[] = getBookmarks();
    const idx = bookmarks.indexOf(slug);
    const next = idx === -1 ? [...bookmarks, slug] : bookmarks.filter((s) => s !== slug);
    localStorage.setItem('guide:bookmarks', JSON.stringify(next));
    window.dispatchEvent(new CustomEvent('bookmark:changed', { detail: { bookmarks: next } }));
    // Update button immediately
    const isNowBookmarked = next.includes(slug);
    btn.textContent = isNowBookmarked ? '★' : '☆';
    btn.classList.toggle('active', isNowBookmarked);
  });

  // Re-sync star if bookmarks change from outside (e.g. card star click)
  window.addEventListener('bookmark:changed', (e: any) => {
    const btn = body.querySelector<HTMLButtonElement>('.sheet-star');
    if (!btn) return;
    const slug = btn.dataset.slug!;
    const isBookmarked = (e.detail.bookmarks as string[]).includes(slug);
    btn.textContent = isBookmarked ? '★' : '☆';
    btn.classList.toggle('active', isBookmarked);
  });
</script>

<style>
  .sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-bg);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: 0 -8px 32px rgba(0,0,0,0.18);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 20;
    height: 75dvh;
    display: flex;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .sheet.open { transform: translateY(0); }

  /* On wider screens: right-side drawer */
  @media (min-width: 720px) {
    .sheet {
      left: auto;
      right: 0;
      top: 0;
      bottom: 0;
      width: 420px;
      height: 100dvh;
      max-height: none;
      border-radius: 0;
      transform: translateX(100%);
    }
    .sheet.open { transform: translateX(0); }
  }

  .sheet-handle {
    flex: 0 0 auto;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-rule);
    border: none;
    margin: var(--space-3) auto var(--space-2);
    cursor: pointer;
    padding: 0;
  }
  .sheet-close {
    display: none;
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgba(26, 24, 20, 0.92);
    color: var(--color-bg);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    z-index: 2;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .sheet-close:hover { background: var(--color-ink); }
  @media (min-width: 720px) {
    .sheet-handle { display: none; }
    .sheet-close { display: block; }
  }
  .sheet-body {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  :global(.sheet-hero) {
    width: 100%;
    max-height: 25dvh;
    object-fit: contain;
    background: var(--color-bg);
    display: block;
    filter: saturate(0.95) contrast(1.05);
  }
  @media (min-width: 720px) {
    :global(.sheet-hero) {
      max-height: 50dvh;
    }
  }
  :global(.sheet-text) {
    padding: var(--space-5) var(--space-5) var(--space-6);
  }
  :global(.sheet-title-row) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-2) 0;
  }
  :global(.sheet-title-row h2) {
    flex: 1 1 auto;
    margin: 0;
  }
  :global(.sheet-text h2) {
    font-family: var(--font-serif);
    font-size: var(--fs-2xl);
    margin: var(--space-2) 0;
  }
  :global(.sheet-star) {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: transparent;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    color: var(--color-ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.15s;
    margin-top: 4px;
  }
  :global(.sheet-star:active) { transform: scale(0.88); }
  :global(.sheet-star.active) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  :global(.sheet-text .place-description) {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-loose);
    color: var(--color-ink-soft);
    margin: var(--space-2) 0 var(--space-4);
  }
  :global(.sheet-text .maps-cta) {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: var(--color-ink);
    color: var(--color-bg);
    text-align: center;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 999px;
    font-family: var(--font-sans, sans-serif);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin: var(--space-4) 0 var(--space-3);
  }
  @media (min-width: 720px) {
    :global(.sheet-text .maps-cta) {
      width: auto;
      display: inline-block;
    }
  }
  :global(.sheet-text .links) {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-size: var(--fs-sm);
  }
</style>
