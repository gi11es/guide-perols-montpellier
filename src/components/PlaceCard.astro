---
import type { CollectionEntry } from 'astro:content';
import Links from './Links.astro';
interface Props {
  place: CollectionEntry<'places'>;
  categoryLabel: string;
  categoryColor: string;
}
const { place, categoryLabel, categoryColor } = Astro.props;
const { name, hero, links, lat, lon, description } = place.data;
const mapsUrl = links?.google_maps
  ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name)}+${lat},${lon}`;
---
<article class="card">
  <a href={mapsUrl} target="_blank" rel="noopener" class="card-link">
    {hero && <img src={`${import.meta.env.BASE_URL}/${hero.replace(/^\//, '')}`} alt={name} class="hero" loading="lazy" width="800" height="600" />}
    <div class="body">
      <p class="eyebrow" style={`color: ${categoryColor};`}>{categoryLabel}</p>
      <h2>{name}</h2>
      {description && <p class="description">{description}</p>}
    </div>
  </a>
  <Links links={links} />
</article>

<style>
  .card {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-6) 0;
  }
  .card:last-child { border-bottom: none; }
  .card-link { color: inherit; border: none; display: block; }
  .hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: saturate(0.95) contrast(1.05);
    margin-bottom: var(--space-4);
  }
  .body h2 {
    font-size: var(--fs-xl);
    margin: var(--space-2) 0;
  }
  .description {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-loose);
    color: var(--color-ink-soft);
    margin-top: var(--space-2);
  }
</style>
