---
import type { CollectionEntry } from 'astro:content';
import Links from './Links.astro';
interface Props {
  place: CollectionEntry<'places'>;
  categoryLabel: string;
  categoryColor: string;
}
const { place, categoryLabel, categoryColor } = Astro.props;
const { name, hero, links, lat, lon, description } = place.data;
const slug = place.data.slug;
const placeIdMatch = links?.google_maps?.match(/place_id:([A-Za-z0-9_-]+)/);
const mapsUrl = placeIdMatch
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name)}&query_place_id=${placeIdMatch[1]}`
  : (links?.google_maps ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name)}+${lat},${lon}`);
---
<article class="card" data-slug={slug}>
  <div class="hero-wrap">
    <a href={mapsUrl} target="_blank" rel="noopener" class="card-link">
      {hero && <img src={`${import.meta.env.BASE_URL}/${hero.replace(/^\//, '')}`} alt={name} class="hero" loading="lazy" width="800" height="600" />}
    </a>
    <button class="card-star" aria-label="Favori" data-slug={slug}>☆</button>
  </div>
  <a href={mapsUrl} target="_blank" rel="noopener" class="card-link">
    <div class="body">
      <p class="eyebrow" style={`color: ${categoryColor};`}>{categoryLabel}</p>
      <h2>{name}</h2>
      {description && <p class="description">{description}</p>}
    </div>
  </a>
  <Links links={links} />
</article>

<script>
  import { getBookmarks, toggleBookmark } from '../scripts/bookmarks';

  function updateCardStars() {
    const bookmarks = new Set(getBookmarks());
    document.querySelectorAll<HTMLButtonElement>('.card-star').forEach((btn) => {
      const s = btn.dataset.slug!;
      btn.textContent = bookmarks.has(s) ? '★' : '☆';
      btn.classList.toggle('active', bookmarks.has(s));
    });
  }

  // Init on load
  updateCardStars();

  // Click handler (delegated)
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.card-star');
    if (!btn) return;
    e.stopPropagation();
    toggleBookmark(btn.dataset.slug!);
  });

  // Cross-component sync
  window.addEventListener('bookmark:changed', () => updateCardStars());
</script>

<style>
  .card {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-6) 0;
  }
  .card:last-child { border-bottom: none; }
  .card-link { color: inherit; border: none; display: block; }
  .hero-wrap {
    position: relative;
  }
  .hero {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: saturate(0.95) contrast(1.05);
    margin-bottom: var(--space-4);
    display: block;
  }
  .card-star {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: none;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(4px);
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    color: var(--color-ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    z-index: 2;
    transition: transform 0.15s;
  }
  .card-star:active { transform: scale(0.88); }
  .card-star.active { color: var(--color-accent); }
  .body h2 {
    font-size: var(--fs-xl);
    margin: var(--space-2) 0;
  }
  .description {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: var(--lh-loose);
    color: var(--color-ink-soft);
    margin-top: var(--space-2);
  }
</style>
