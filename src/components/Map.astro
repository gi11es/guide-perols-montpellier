---
import type { CollectionEntry } from 'astro:content';

interface Category { slug: string; label: string; color: string; }
interface Props {
  places: CollectionEntry<'places'>[];
  categories: Category[];
  center: { lat: number; lon: number };
  house?: { lat: number; lon: number };
}
const { places, categories, center, house } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const placeData = places.map((p) => ({
  slug: p.data.slug,
  name: p.data.name,
  lat: p.data.lat,
  lon: p.data.lon,
  category: p.data.category,
  hero: p.data.hero ?? '',
}));
const catColors = Object.fromEntries(categories.map((c) => [c.slug, c.color]));
const catLabels = Object.fromEntries(categories.map((c) => [c.slug, c.label]));
const houseLngLat = house ? [house.lon, house.lat] : null;
---
<div id="map" data-center={`${center.lon},${center.lat}`}></div>

<script is:inline define:vars={{ placeData, catColors, catLabels, baseUrl, houseLngLat }}>
  window.__GUIDE__ = { placeData, catColors, catLabels, baseUrl, houseLngLat };
</script>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const el = document.getElementById('map')!;
  const [lon, lat] = el.dataset.center!.split(',').map(Number);
  const { placeData, catColors, catLabels, baseUrl, houseLngLat } = (window as any).__GUIDE__;

  const map = new maplibregl.Map({
    container: el,
    center: [lon, lat],
    zoom: 10,
    style: {
      version: 8,
      sources: {
        osm: {
          type: 'raster',
          tiles: [
            'https://a.tile.openstreetmap.org/{z}/{x}/{y}.png',
            'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png',
            'https://c.tile.openstreetmap.org/{z}/{x}/{y}.png',
          ],
          tileSize: 256,
          attribution: '© OpenStreetMap contributors',
          maxzoom: 19,
        },
      },
      layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
    },
  });

  map.on('load', () => {
    // --- House marker (single HTMLMarker, no perf concern) ---
    if (houseLngLat) {
      const houseEl = document.createElement('div');
      houseEl.className = 'house-marker';
      houseEl.title = 'La maison';
      houseEl.innerHTML = `
        <svg viewBox="0 0 32 32" width="20" height="20" xmlns="http://www.w3.org/2000/svg" aria-label="La maison">
          <circle cx="16" cy="16" r="15" fill="#F4EFE6" stroke="#1A1814" stroke-width="2"/>
          <path d="M9 16l7-6 7 6v7a1 1 0 0 1-1 1h-4v-5h-4v5h-4a1 1 0 0 1-1-1z" fill="#C25B3F" stroke="#1A1814" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      `;
      new maplibregl.Marker({ element: houseEl, anchor: 'center' })
        .setLngLat(houseLngLat as [number, number])
        .addTo(map);
    }

    // --- Build GeoJSON from placeData ---
    function hashSlugToInt(s: string): number {
      let h = 0;
      for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
      return Math.abs(h);
    }

    const features = placeData.map((p: any) => ({
      type: 'Feature',
      id: hashSlugToInt(p.slug),
      geometry: { type: 'Point', coordinates: [p.lon, p.lat] },
      properties: {
        slug: p.slug,
        name: p.name,
        category: p.category,
        hero: p.hero,
      },
    }));
    const slugToId: Record<string, number> = Object.fromEntries(
      features.map((f: any) => [f.properties.slug, f.id])
    );

    map.addSource('places', {
      type: 'geojson',
      data: { type: 'FeatureCollection', features } as GeoJSON.FeatureCollection,
      promoteId: 'id',
    });

    // Build match expression for per-category colors
    const matchColor: any[] = ['match', ['get', 'category']];
    for (const [slug, color] of Object.entries(catColors as Record<string, string>)) {
      matchColor.push(slug, color);
    }
    matchColor.push('#1A1814'); // default fallback

    map.addLayer({
      id: 'places-dots',
      type: 'circle',
      source: 'places',
      paint: {
        'circle-color': matchColor as any,
        'circle-radius': [
          'case',
          ['boolean', ['feature-state', 'selected'], false], 11,
          7,
        ] as any,
        'circle-stroke-width': [
          'case',
          ['boolean', ['feature-state', 'selected'], false], 3,
          2,
        ] as any,
        'circle-stroke-color': [
          'case',
          ['boolean', ['feature-state', 'selected'], false], '#1A1814',
          '#F4EFE6',
        ] as any,
      },
    });

    // Helper: pick the feature whose centre is closest to the pointer in pixel space.
    function closestFeature(features: any[], pointerPx: { x: number; y: number }) {
      let best = features[0];
      let bestDist = Infinity;
      for (const f of features) {
        const coords = f.geometry.coordinates;
        const px = map.project(coords);
        const d = Math.hypot(px.x - pointerPx.x, px.y - pointerPx.y);
        if (d < bestDist) {
          bestDist = d;
          best = f;
        }
      }
      return best;
    }

    // Track the currently-hovered feature so clicks always open whatever
    // the user sees highlighted/popped-up.
    let hoveredFeature: any = null;

    map.on('mouseenter', 'places-dots', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'places-dots', () => { map.getCanvas().style.cursor = ''; hoveredFeature = null; });

    // Hover popup (non-touch only) + track hoveredFeature on every mousemove
    const isTouch = window.matchMedia('(hover: none)').matches;
    let activePopup: maplibregl.Popup | null = null;

    map.on('mousemove', 'places-dots', (e) => {
      const features = e.features ?? [];
      if (!features.length) return;
      const f = closestFeature(features, e.point);
      // If still hovering the same feature, do nothing.
      if (hoveredFeature && hoveredFeature.properties.slug === f.properties.slug) return;
      hoveredFeature = f;
      if (isTouch) return;
      const p = f.properties as any;
      const color = (catColors as any)[p.category] ?? '#1A1814';
      const label = (catLabels as any)[p.category] ?? p.category;
      const heroSrc = p.hero ? `${baseUrl}${p.hero.replace(/^\//, '')}` : '';
      const html = `
        <div class="hover-popup-inner">
          ${heroSrc ? `<img class="hover-popup-img" src="${heroSrc}" alt="${p.name}" />` : ''}
          <p class="hover-popup-eyebrow" style="color:${color}">${label}</p>
          <h3 class="hover-popup-name">${p.name}</h3>
        </div>
      `;
      if (activePopup) { activePopup.remove(); }
      activePopup = new maplibregl.Popup({
        closeButton: false,
        closeOnClick: false,
        anchor: 'bottom',
        offset: 12,
      })
        .setLngLat((f.geometry as any).coordinates)
        .setHTML(html)
        .addTo(map);
    });

    map.on('mouseleave', 'places-dots', () => {
      if (activePopup) { activePopup.remove(); activePopup = null; }
    });

    // Tap on empty map (no marker under click) → close the open sheet.
    map.on('click', (e) => {
      const hit = map.queryRenderedFeatures(e.point, { layers: ['places-dots'] });
      if (hit.length === 0) {
        window.dispatchEvent(new CustomEvent('sheet:close'));
      }
    });

    // Click handler — if we have a hovered feature, that's what the user is aiming at.
    // Otherwise fall back to the closest feature to the click point.
    map.on('click', 'places-dots', (e) => {
      const features = e.features ?? [];
      if (!features.length) return;
      let target = hoveredFeature;
      // Verify the hovered feature is among the clicked ones; if not, fall back.
      if (!target || !features.some((f: any) => f.properties.slug === target.properties.slug)) {
        target = closestFeature(features, e.point);
      }
      window.dispatchEvent(new CustomEvent('place:select', { detail: target.properties }));
    });

    // Selected state via feature-state
    let selectedFeatureId: number | null = null;
    window.addEventListener('place:select', (e: any) => {
      const slug = e.detail.slug;
      const fid = slugToId[slug];
      if (selectedFeatureId !== null) {
        map.setFeatureState({ source: 'places', id: selectedFeatureId }, { selected: false });
      }
      if (fid !== undefined) {
        map.setFeatureState({ source: 'places', id: fid }, { selected: true });
        selectedFeatureId = fid;
      }
    });
    window.addEventListener('place:deselect', () => {
      if (selectedFeatureId !== null) {
        map.setFeatureState({ source: 'places', id: selectedFeatureId }, { selected: false });
        selectedFeatureId = null;
      }
    });

    // Category filter
    function applyCatFilter(cat: string) {
      if (cat === 'all' || !cat) {
        map.setFilter('places-dots', null);
      } else {
        map.setFilter('places-dots', ['==', ['get', 'category'], cat]);
      }
    }
    window.addEventListener('category:filter', (e: any) => {
      applyCatFilter(e.detail.category);
    });
    // Apply initial filter from URL once the layer is ready
    const initCat = new URLSearchParams(window.location.search).get('cat') ?? 'all';
    applyCatFilter(initCat);
  });
</script>

<style>
  #map {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
  }
  /* House marker */
  :global(.house-marker) {
    cursor: default;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
  }
  /* MapLibre hover popup */
  :global(.maplibregl-popup-tip) { display: none; }
  :global(.maplibregl-popup-content) {
    background: var(--color-bg, #F4EFE6);
    border-radius: 8px;
    padding: 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    overflow: hidden;
    min-width: 140px;
    max-width: 160px;
  }
  :global(.hover-popup-inner) {
    display: flex;
    flex-direction: column;
  }
  :global(.hover-popup-img) {
    width: 120px;
    height: 90px;
    object-fit: cover;
    display: block;
    filter: saturate(0.92) contrast(1.06);
  }
  :global(.hover-popup-eyebrow) {
    font-size: 9px;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 6px 10px 2px;
    line-height: 1;
  }
  :global(.hover-popup-name) {
    font-family: var(--font-serif, 'Fraunces', serif);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 10px 8px;
    color: var(--color-ink, #1A1814);
  }
</style>
